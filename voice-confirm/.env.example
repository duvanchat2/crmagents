# ============================================================
# Genix · llamada automática de confirmación — variables
# Copie este archivo a .env en el VPS (/opt/genix-voice/.env).
# .env nunca se sube al repositorio. Los valores REEMPLAZA_... son obligatorios.
# Las claves internas (LIVEKIT_*, REDIS_PASSWORD, INTERNAL_TOKEN, DISPATCHER_TOKEN,
# N8N_WEBHOOK_SECRET) las genera scripts/bootstrap.sh si siguen en REEMPLAZA_.
# Si un valor tiene espacios, & o $, enciérrelo entre comillas simples: CLAVE='valor'.
# ============================================================

# ---------- LiveKit (interno, en este mismo VPS) ----------
# Se generan solas. Si las cambia, vuelva a correr scripts/bootstrap.sh.
LIVEKIT_API_KEY=REEMPLAZA_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REEMPLAZA_LIVEKIT_API_SECRET
REDIS_PASSWORD=REEMPLAZA_REDIS_PASSWORD
# Redis propio de este servicio (solo 127.0.0.1). 6380 para no chocar con un Redis que ya exista en 6379.
REDIS_PORT=6380
# Token entre el agente y el dispatcher (no sale del VPS).
INTERNAL_TOKEN=REEMPLAZA_INTERNAL_TOKEN

# ---------- Zadarma (línea 601) ----------
# En my.zadarma.com: "Mi centralita" → "Extensiones". Cree o use una extensión,
# active la grabación si la quiere también en Zadarma, y ponga el 601 como CallerID.
# Usuario = número de la extensión (formato 123456-100). Contraseña = la de esa extensión.
# ¿Aún no tiene Zadarma? Deje las tres en REEMPLAZA_: el servicio queda en MODO SIMULACIÓN
# y puede probar el agente desde el navegador (https://DISPATCHER_DOMAIN/prueba).
ZADARMA_SIP_HOST=pbx.zadarma.com
ZADARMA_SIP_USER=REEMPLAZA_EXTENSION_ZADARMA
ZADARMA_SIP_PASSWORD=REEMPLAZA_CLAVE_EXTENSION_ZADARMA
# El número 601 comprado, en formato internacional: +5760XXXXXXXX
ZADARMA_CALLER_NUMBER=REEMPLAZA_NUMERO_601
SIP_TRUNK_NAME=zadarma-genix

# ---------- Oído: AssemblyAI ----------
# https://www.assemblyai.com/dashboard → API Keys.
ASSEMBLYAI_API_KEY=REEMPLAZA_ASSEMBLYAI_API_KEY
# universal-streaming-multilingual (USD 0,15/h) o universal-3-6-pro (más preciso con dígitos, ~USD 0,45/h).
STT_MODEL=universal-streaming-multilingual
# Silencio máximo (ms) antes de dar por terminado el turno. Súbalo si corta al dictar la cédula.
STT_MAX_TURN_SILENCE_MS=1600

# ---------- Cerebro: Claude Haiku ----------
# openrouter (usa sus créditos de OpenRouter) o anthropic (API de Anthropic directa).
LLM_PROVIDER=openrouter
# Verifique el nombre exacto en https://openrouter.ai/models (buscar "haiku").
LLM_MODEL=anthropic/claude-haiku-5.5
# off = responde sin "pensar" (menos demora en la llamada). low = piensa poco.
LLM_REASONING=off
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=REEMPLAZA_OPENROUTER_API_KEY
# Solo si LLM_PROVIDER=anthropic: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# ---------- Voz ----------
# fishaudio (USD 15 por millón de caracteres) o elevenlabs (USD 40 por millón).
TTS_PROVIDER=fishaudio
# https://fish.audio → API Keys. La voz: elija una en español en fish.audio y copie su ID.
FISH_API_KEY=REEMPLAZA_FISH_API_KEY
FISH_VOICE_ID=REEMPLAZA_FISH_VOICE_ID
FISH_MODEL=s2.1-pro
# Solo si TTS_PROVIDER=elevenlabs: https://elevenlabs.io → Developers → API Keys; voz en "Voices".
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_flash_v2_5

# ---------- n8n ----------
# URL del nodo Webhook de n8n que recibe el resultado de cada llamada (POST JSON).
# Opcional para probar: vacío = los resultados quedan solo en el VPS (data/calls/).
# Las simulaciones también llegan aquí, con "simulacion": true (n8n no debe activar el curso).
N8N_RESULT_WEBHOOK_URL=REEMPLAZA_URL_WEBHOOK_N8N
# Firma HMAC-SHA256 del cuerpo en la cabecera X-Genix-Signature (se genera sola).
N8N_WEBHOOK_SECRET=REEMPLAZA_N8N_WEBHOOK_SECRET
# Token que n8n manda como "Authorization: Bearer ..." al pedir una llamada (se genera solo).
DISPATCHER_TOKEN=REEMPLAZA_DISPATCHER_TOKEN
# 127.0.0.1 si n8n corre en este VPS o si usa el perfil tls (Caddy). 0.0.0.0 para abrirlo (no recomendado sin TLS).
DISPATCHER_HOST=127.0.0.1
DISPATCHER_PORT=8088
# Dominio con DNS apuntando a este VPS para servir el dispatcher por HTTPS (perfil tls). Vacío = sin TLS.
# Lo necesita el simulador del navegador (/prueba). Sin DNS propio sirve uno gratuito con la IP
# del VPS con guiones: 203-0-113-10.sslip.io (bootstrap.sh le sugiere el suyo).
DISPATCHER_DOMAIN=
# Normalmente vacío: el simulador usa wss://DISPATCHER_DOMAIN. Solo si LiveKit está en otra URL pública.
LIVEKIT_PUBLIC_URL=
# false en casi todos los VPS. true solo si bootstrap.sh avisa que el VPS está detrás de NAT
# (la IP pública no está en sus interfaces, típico de AWS, GCP u Oracle) y el simulador no tiene audio.
LIVEKIT_USE_EXTERNAL_IP=false
# IP del servidor de n8n, para abrirle el puerto del dispatcher solo a esa IP. Vacío = no se abre.
N8N_ALLOWED_IP=

# ---------- Grabaciones en Bunny.net (opcional) ----------
# Storage Zone → FTP & API Access: nombre de la zona y "Password". Vacío = quedan solo en el VPS.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
# Región de la zona: storage.bunnycdn.com (Falkenstein), ny.storage.bunnycdn.com, br.storage.bunnycdn.com, ...
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_PATH_PREFIX=grabaciones-confirmacion
# Opcional: URL de una Pull Zone privada (con token) para escuchar las grabaciones.
BUNNY_PULL_ZONE_URL=
# Días que se guardan en el VPS después de entregadas a n8n.
LOCAL_RETENTION_DAYS=30

# ---------- Reglas de llamada ----------
# Festivos de Colombia (AAAA-MM-DD, separados por coma). Complete los del año siguiente.
COLOMBIA_HOLIDAYS=2026-11-02,2026-11-16,2026-12-08,2026-12-25
# true solo para pruebas: permite llamar fuera del horario de la Ley 2300.
ALLOW_OUTSIDE_HOURS=false
RINGING_TIMEOUT_S=30
MAX_CALL_DURATION_S=300
AGENT_NAME=genix-confirmacion

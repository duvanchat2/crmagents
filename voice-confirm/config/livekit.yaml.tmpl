# Generado por scripts/render-config.sh a partir de .env. No editar ./generated/livekit.yaml a mano.
# LiveKit solo atiende al agente y al servicio SIP de esta misma máquina:
# sus puertos (7880, 7881, 50000-50100) quedan cerrados hacia Internet por el firewall.
port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: false
redis:
  address: 127.0.0.1:6379
  password: ${REDIS_PASSWORD}
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
room:
  empty_timeout: 60
  departure_timeout: 10
logging:
  level: info
